<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CDN Central Router Diagnostics (:9000)</title>
  <style>
    :root {
      --bg: #090d16;
      --card-bg: #111827;
      --border: #1f2937;
      --accent: #38bdf8;
      --accent-dim: rgba(56, 189, 248, 0.15);
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
      --text-main: #f9fafb;
      --text-muted: #9ca3af;
      --code-bg: #1e293b;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background-color: var(--bg); color: var(--text-main); padding: 2rem 1.5rem; line-height: 1.5; }
    .container { max-width: 1200px; margin: 0 auto; }
    header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
    .badge { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.85rem; font-weight: 600; }
    .badge-green { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
    .badge-red { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
    .badge-blue { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
    .pulse-dot { width: 8px; height: 8px; border-radius: 50%; background: #34d399; box-shadow: 0 0 10px #34d399; }
    .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2rem; }
    .card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; }
    .card-title { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.5rem; }
    .card-value { font-size: 1.75rem; font-weight: 700; color: var(--text-main); }
    .card-sub { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem; }
    .section-title { font-size: 1.15rem; font-weight: 600; margin-bottom: 1rem; color: #e5e7eb; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
    table { width: 100%; border-collapse: collapse; text-align: left; }
    th { padding: 0.75rem 1rem; background: #1f2937; color: #9ca3af; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; }
    td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--border); font-size: 0.9rem; }
    tr:hover td { background: rgba(255, 255, 255, 0.02); }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .code { font-family: monospace; background: var(--code-bg); padding: 0.2rem 0.4rem; border-radius: 4px; font-size: 0.85rem; }
    .btn { background: var(--accent); color: #0f172a; border: none; padding: 0.5rem 1.2rem; border-radius: 6px; font-weight: 600; cursor: pointer; transition: opacity 0.2s; font-size: 0.85rem; }
    .btn:hover { opacity: 0.9; }
    .btn-danger { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); padding: 0.35rem 0.8rem; font-size: 0.8rem; border-radius: 6px; cursor: pointer; }
    .btn-danger:hover { background: #ef4444; color: #fff; }
    .btn-success { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); padding: 0.35rem 0.8rem; font-size: 0.8rem; border-radius: 6px; cursor: pointer; }
    .btn-success:hover { background: #10b981; color: #fff; }
    .btn-secondary { background: transparent; border: 1px solid var(--border); color: var(--text-muted); padding: 0.4rem 0.9rem; border-radius: 6px; font-size: 0.85rem; cursor: pointer; }
    .btn-secondary:hover { color: var(--text-main); border-color: var(--text-muted); }
    .nav-links { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
    .strategy-control { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 1rem; }
    select { background: #1e293b; border: 1px solid var(--border); color: #fff; padding: 0.5rem 0.75rem; border-radius: 6px; font-size: 0.9rem; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div>
        <h1 style="font-size: 1.5rem; font-weight: 700; display: flex; align-items: center; gap: 0.75rem;">
          🧭 Central CDN Router
          <span class="badge badge-green"><span class="pulse-dot"></span> Port <%= port %> ONLINE</span>
        </h1>
        <p style="color: var(--text-muted); font-size: 0.875rem; margin-top: 0.25rem;">
          Health monitoring, failover, and routing across Mumbai (:8001), Singapore (:8002), Frankfurt (:8003), New York (:8004)
        </p>
      </div>
      <div class="nav-links">
        <a href="/cdn/config" target="_blank" class="code">GET /cdn/config</a>
        <a href="/cdn/edges" target="_blank" class="code">GET /cdn/edges</a>
        <a href="/cdn/decisions" target="_blank" class="code">GET /cdn/decisions</a>
        <button class="btn-secondary" onclick="location.reload()">↻ Refresh</button>
      </div>
    </header>

    <!-- Key Metrics Grid -->
    <div class="grid-4">
      <div class="card">
        <div class="card-title">Active Strategy</div>
        <div class="card-value" style="color: #38bdf8; font-size: 1.35rem;">
          <%= strategy %>
        </div>
        <div class="card-sub">ROUND_ROBIN or LOWEST_LATENCY</div>
      </div>

      <div class="card">
        <div class="card-title">Healthy Edge PoPs</div>
        <div class="card-value" style="color: #34d399;">
          <%= edges.filter(e => !e.disabled && e.status === 'HEALTHY').length %> / <%= edges.length %>
        </div>
        <div class="card-sub">Available for routing</div>
      </div>

      <div class="card">
        <div class="card-title">Routing Decisions</div>
        <div class="card-value"><%= decisions.length %></div>
        <div class="card-sub">Recorded in memory</div>
      </div>

      <div class="card">
        <div class="card-title">Router Uptime</div>
        <div class="card-value"><%= uptimeSeconds %>s</div>
        <div class="card-sub">Listening on port <%= port %></div>
      </div>
    </div>

    <!-- Strategy Switching Control -->
    <div class="card" style="margin-bottom: 2rem;">
      <h2 class="section-title">⚙️ Routing Strategy Configuration</h2>
      <p style="font-size: 0.85rem; color: var(--text-muted);">
        Select routing algorithm applied to incoming <code>/cdn/content/:filename</code> requests:
      </p>
      <div class="strategy-control">
        <select id="strategySelect">
          <option value="ROUND_ROBIN" <%= strategy === 'ROUND_ROBIN' ? 'selected' : '' %>>1. Round Robin (Sequential distribution across healthy edges)</option>
          <option value="LOWEST_LATENCY" <%= strategy === 'LOWEST_LATENCY' ? 'selected' : '' %>>2. Lowest Simulated Latency (Mumbai 35ms -> Singapore 80ms -> Frankfurt 150ms -> NYC 180ms)</option>
        </select>
        <button class="btn" onclick="updateStrategy()">Update Strategy (PUT /cdn/config)</button>
        <span id="strategyMsg" style="font-size: 0.85rem;"></span>
      </div>
    </div>

    <!-- Edge Health & Failure Simulation Table -->
    <div class="card" style="margin-bottom: 2rem;">
      <div class="section-title">
        <span>⚡ Edge Servers Health &amp; Failure Simulator</span>
        <span style="font-size: 0.85rem; color: var(--text-muted);">Simulate an edge failure to verify automatic failover</span>
      </div>
      <table>
        <thead>
          <tr>
            <th>Edge Name</th>
            <th>Location</th>
            <th>Port</th>
            <th>Configured Latency</th>
            <th>Health Status</th>
            <th>Total Requests</th>
            <th>Hit Ratio</th>
            <th>Failure Simulation</th>
          </tr>
        </thead>
        <tbody>
          <% edges.forEach(function(edge) { %>
            <tr>
              <td><strong><%= edge.name %></strong></td>
              <td><%= edge.location %></td>
              <td><span class="code">:<%= edge.port %></span></td>
              <td>
                <strong style="color: #38bdf8;"><%= edge.simulatedLatencyMs %> ms</strong>
              </td>
              <td>
                <% if (edge.disabled) { %>
                  <span class="badge badge-red">OFFLINE (SIMULATED)</span>
                <% } else if (edge.status === 'HEALTHY') { %>
                  <span class="badge badge-green">HEALTHY</span>
                <% } else { %>
                  <span class="badge badge-red"><%= edge.status %></span>
                <% } %>
              </td>
              <td><strong><%= edge.totalRequests || edge.requestsRouted || 0 %></strong></td>
              <td><span class="code"><%= edge.cacheHitRatio || '0.0%' %></span></td>
              <td>
                <% if (edge.disabled) { %>
                  <button class="btn-success" onclick="toggleEdge('<%= edge.id %>', 'recover')">Restore Online</button>
                <% } else { %>
                  <button class="btn-danger" onclick="toggleEdge('<%= edge.id %>', 'failure')">Simulate Failure</button>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Recorded Routing Decisions Log -->
    <div class="card">
      <h2 class="section-title">📜 Recent Routing Decisions</h2>
      <table>
        <thead>
          <tr>
            <th>Time</th>
            <th>File</th>
            <th>Strategy</th>
            <th>Selected Edge</th>
            <th>Simulated Latency</th>
            <th>Actual HTTP Duration</th>
            <th>Cache Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (decisions.length === 0) { %>
            <tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">No requests routed yet. Try fetching <code>/cdn/content/sample.txt</code>!</td></tr>
          <% } else { %>
            <% decisions.forEach(function(d) { %>
              <tr>
                <td><%= new Date(d.timestamp).toLocaleTimeString() %></td>
                <td><strong><%= d.file %></strong></td>
                <td><span class="code"><%= d.strategy %></span></td>
                <td><strong style="color: #38bdf8;"><%= d.selectedEdge %></strong></td>
                <td style="color: #38bdf8;"><%= d.simulatedLatencyMs %> ms</td>
                <td style="color: <%= d.actualDurationMs < 50 ? '#34d399' : '#f59e0b' %>;"><%= d.actualDurationMs %> ms</td>
                <td>
                  <span class="badge <%= d.cacheStatus === 'HIT' ? 'badge-green' : 'badge-blue' %>">
                    <%= d.cacheStatus %>
                  </span>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    async function updateStrategy() {
      const select = document.getElementById('strategySelect');
      const val = select.value;
      const msg = document.getElementById('strategyMsg');
      msg.innerText = 'Updating...';
      msg.style.color = '#38bdf8';

      try {
        const res = await fetch('/cdn/config', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ strategy: val })
        });
        const data = await res.json();
        if (res.ok) {
          msg.innerText = 'Updated to ' + data.strategy;
          msg.style.color = '#34d399';
          setTimeout(() => location.reload(), 500);
        } else {
          msg.innerText = 'Error: ' + data.error;
          msg.style.color = '#ef4444';
        }
      } catch (e) {
        msg.innerText = 'Error: ' + e.message;
        msg.style.color = '#ef4444';
      }
    }

    async function toggleEdge(edgeId, action) {
      try {
        const res = await fetch('/admin/edges/' + edgeId + '/' + action, { method: 'POST' });
        if (res.ok) {
          location.reload();
        } else {
          const data = await res.json();
          alert('Action failed: ' + (data.error || res.statusText));
        }
      } catch (e) {
        alert('Request failed: ' + e.message);
      }
    }
  </script>
</body>
</html>
