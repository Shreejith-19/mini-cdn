{
  "name": "mini-cdn-backend",
  "version": "1.0.0",
  "description": "Mini CDN Backend - Origin, Edge, Router and Monitoring Services",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:origin": "node server.js",
    "start:mumbai": "node edge/edgeServer.js --edge=mumbai",
    "start:singapore": "node edge/edgeServer.js --edge=singapore",
    "start:frankfurt": "node edge/edgeServer.js --edge=frankfurt",
    "start:newyork": "node edge/edgeServer.js --edge=newyork",
    "start:edges": "node edge/startEdges.js",
    "start:router": "node router/routerServer.js",
    "dev": "node --watch server.js",
    "test": "node verify.js",
    "test:origin": "node origin/origin.test.js",
    "test:edge": "node edge/edge.test.js",
    "test:router": "node router/router.test.js",
    "test:metrics": "node metrics/metrics.test.js",
    "test:simulator": "node test-simulator.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  }
}
