{
  "name": "mini-cdn",
  "version": "1.0.0",
  "description": "Mini CDN (Content Delivery Network) Simulator",
  "private": true,
  "type": "module",
  "scripts": {
    "start:backend": "npm --prefix backend start",
    "start:origin": "npm --prefix backend start",
    "start:mumbai": "npm --prefix backend run start:mumbai",
    "start:singapore": "npm --prefix backend run start:singapore",
    "start:frankfurt": "npm --prefix backend run start:frankfurt",
    "start:newyork": "npm --prefix backend run start:newyork",
    "start:edges": "npm --prefix backend run start:edges",
    "start:router": "npm --prefix backend run start:router",
    "benchmark": "node benchmarks/benchmark.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:origin": "npm --prefix backend run test:origin",
    "test:edge": "npm --prefix backend run test:edge",
    "test:router": "npm --prefix backend run test:router",
    "test:metrics": "npm --prefix backend run test:metrics",
    "test:simulator": "npm --prefix backend run test:simulator",
    "test:final": "npm --prefix backend run test:final",
    "test:load": "node benchmarks/loadTest.js",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": [
    "cdn",
    "edge-caching",
    "routing",
    "simulator",
    "express",
    "react",
    "recharts"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "autocannon": "^9.0.0"
  }
}
