{
  "name": "mini-cdn-edge-server",
  "version": "1.0.0",
  "description": "Mini CDN Edge Server with in-memory caching and EJS diagnostics",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "start:mumbai": "node src/server.js --edge=mumbai",
    "start:singapore": "node src/server.js --edge=singapore",
    "start:frankfurt": "node src/server.js --edge=frankfurt",
    "start:newyork": "node src/server.js --edge=newyork",
    "test": "node tests/edge.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2"
  }
}
